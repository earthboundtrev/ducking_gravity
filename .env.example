# Copy to .env and fill in real values (never commit .env).
# Netlify: set these in Site settings → Environment variables.
# Contact-form secrets are server-only — never inject them into HTML.

# Used by netlify/functions/contact-form.mjs (Resend + reCAPTCHA siteverify)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=Ducking Gravity <forms@your-verified-domain.com>
CONTACT_INBOX=duckinggravity@gmail.com
RECAPTCHA_SECRET_KEY=your_recaptcha_v2_secret

# Server-side only. Used by the Netlify receiver for SmartAstro class availability sync.
MARKETING_SYNC_SHARED_SECRET=replace_with_the_same_secret_configured_in_smartastro

# Optional / future use (Vite-style names)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_test_publishable_key
VITE_API_URL=http://localhost:3000
